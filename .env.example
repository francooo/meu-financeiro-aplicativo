# URL da API publicada na Vercel (repositório do web).
# Sem barra no final.
EXPO_PUBLIC_API_URL=https://sua-api.vercel.app

# Client IDs do Google (OAuth 2.0), criados no Google Cloud Console.
# WEB define a audiência do idToken e é o único citado no código.
# ANDROID não aparece no código: o Google usa (pacote + SHA-1) para
# autorizar o app. O login exige development build — não roda no Expo Go.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# NUNCA coloque aqui DATABASE_URL, SESSION_SECRET ou ALLOWED_EMAIL.
# Tudo com prefixo EXPO_PUBLIC_ é embutido no binário e legível por quem
# abrir o APK. Esses três são segredos do servidor e vivem apenas nas
# variáveis de ambiente do projeto da Vercel.
